{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Novel Studio",
  "version": "0.0.0",
  "identifier": "com.vne.studio",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Visual Novel Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Write and publish visual novels",
    "longDescription": "The Visual Novel Engine studio: write, edit and publish visual novels without a development environment.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
